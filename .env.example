# ChurchCore Sovereign Control Plane: Environment Configuration (Next.js 16 + Supabase + Vercel)

# 1. Supabase Control Plane Database & Auth (Constitution Section III: Zero Customer PII)
NEXT_PUBLIC_SUPABASE_URL="https://your-control-plane-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Control Plane Operator Authentication Gate (Fallback / Sovereign Admin Credentials)
CONTROL_PLANE_ADMIN_USERNAME="admin@churchcore.io"
CONTROL_PLANE_ADMIN_PASSWORD="your-strong-operator-password"
CONTROL_PLANE_SESSION_SECRET="your-64-char-hmac-session-signing-secret"

# 3. Embedded Security Architecture & Cron / Webhook Secrets
ARCJET_KEY="aj_key_your_secret_here"
CRON_SECRET="your-long-random-vercel-cron-secret"
GITHUB_WEBHOOK_SECRET="whsec_your_github_webhook_secret"
GITHUB_TOKEN="ghp_your_fine_grained_github_pat_for_fleet_sync"
VERCEL_TOKEN="your_vercel_api_token_for_deployment_telemetry"

# 4. OpenRouter AI Gateway (COUNCIL-2026-010: Zero Data Retention & Sovereign Model Evaluator)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-pro"
OPENROUTER_FLASH_MODEL="google/gemini-2.5-flash"
OPENROUTER_FAST_MODEL="google/gemini-2.5-flash-lite"

# 5. Canonical Application URL
NEXT_PUBLIC_APP_URL="https://churchcore-business.vercel.app"
